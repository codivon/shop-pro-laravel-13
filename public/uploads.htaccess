# امنیتی: خنثی‌سازی کامل اجرای کد در پوشه آپلودها
# (دفاع دوم در صورتی که قانون RewriteRule فایل اصلی .htaccess حذف/بازنویسی شود)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php\d*|phtml|pht|pl|py|cgi|sh|asp|aspx|jsp|shtml|phar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# جلوگیری از اجرای موتور بازنویسی برای اسکریپت‌ها
Options -ExecCGI -Indexes
AddType text/plain .php .php3 .php4 .php5 .php7 .php8 .phtml .pht .phar
