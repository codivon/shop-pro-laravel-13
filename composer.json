{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "alexusmai/laravel-file-manager": "^3.3.3",
        "barryvdh/laravel-debugbar": "^4.3.0",
        "cviebrock/eloquent-sluggable": "^13.0.0",
        "doctrine/dbal": "^3.1",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^3.11",
        "jenssegers/agent": "^2.6",
        "kavenegar/laravel": "^1.3",
        "laravel-notification-channels/webpush": "^11.0.0",
        "laravel/framework": "^13.0",
        "laravel/pulse": "^1.7",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.4",
        "maatwebsite/excel": "^4.0.3",
        "madnest/madzipper": "1.7.x-dev",
        "melipayamak/laravel": "^1.0",
        "milon/barcode": "^13.1",
        "morilog/jalali": "^3.2",
        "nwidart/laravel-modules": "^13.0",
        "paquettg/php-html-parser": "^2.2",
        "predis/predis": "^2.3.0",
        "pusher/pusher-php-server": "^7.2",
        "rachidlaasri/laravel-installer": "^4.1",
        "rap2hpoutre/laravel-log-viewer": "^3.1.0",
        "sadegh19b/laravel-persian-validation": "^2.1.0",
        "shetabit/payment": "7.0.0",
        "spatie/image-optimizer": "^1.8",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-backup": "^10.2.2",
        "spatie/laravel-sitemap": "^7.3.2",
        "wikimedia/composer-merge-plugin": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^2.0",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "*",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "barryvdh/laravel-debugbar": true,
            "composer/package-versions-deprecated": true,
            "cviebrock/eloquent-sluggable": true,
            "intervention/image": true,
            "laravel/breeze": true,
            "laravel/sail": true,
            "maatwebsite/excel": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "rachidlaasri/laravel-installer": true,
            "spatie/laravel-backup": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Shetabit\\Payment\\": "packages/shetabit/payment/src/",
            "Shetabit\\Multipay\\": "packages/shetabit/multipay/src/",
            "Codedge\\Updater\\": "packages/codedge/laravel-selfupdater/src/",
            "Themes\\": "themes/"
        },
        "files": [
            "bootstrap/helpers.php",
            "packages/codedge/laravel-selfupdater/src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
