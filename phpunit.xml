<?xml version="1.0" encoding="UTF-8"?>
<!--
    PHPUnit اختصاصی تم سانیار — فاز K
    اجرا:  php vendor/bin/phpunit -c themes/Saniar/phpunit.xml
    (از ریشهٔ میزبان؛ بوت‌استراپ به vendor میزبان پوینت می‌کند و کد میزبان
    دست‌نخورده می‌ماند — تست‌ها ۱۰۰٪ داخل ریپوی تم‌اند)
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../../vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Saniar">
            <directory suffix="Test.php">./Tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <server name="APP_ENV" value="testing"/>
        <server name="CURRENT_THEME" value="Saniar"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="CACHE_DRIVER" value="array"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <ini name="memory_limit" value="1G"/>
    </php>
    <source>
        <include>
            <directory suffix=".php">./src</directory>
        </include>
    </source>
</phpunit>
